# Optional. Without these, Cleared runs in simulation mode.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com
# JSON map from Cleared beneficiary IDs to Airwallex sandbox beneficiary IDs
AIRWALLEX_BENEFICIARY_MAP={}

# Optional. Without it, inbound messages are read by the rules-based reader.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
